# Layer 8 Report API. deploy.sh fills in the @PLACEHOLDERS@ and installs this as
# a user service (systemctl --user), so nothing needs root. Only hardening that
# works in user units is used; mount namespacing is left out on purpose.
[Unit]
Description=Layer 8 Report API (layer8d)
After=network.target

[Service]
Type=simple
ExecStart=@BIN@ -addr @ADDR@ -data @DATA@ -site https://www.layer8report.com
Restart=on-failure
RestartSec=2

# The API is built to stay within a few MB. These are the backstop: the Go
# runtime collects harder past 48 MB, and systemd restarts it past 96 MB.
Environment=GOMEMLIMIT=48MiB
MemoryHigh=64M
MemoryMax=96M

NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
